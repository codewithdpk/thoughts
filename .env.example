DATABASE_URL="postgresql://thoughts:thoughts@localhost:5432/thoughts?schema=public"
# Managed Postgres (e.g. Aiven): paste the provider's CA certificate (PEM) here to
# verify TLS. On Vercel, paste the multi-line PEM as-is into the env var value.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# generate with: openssl rand -base64 48
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# used by `npm run db:seed` to create/update the login user
SEED_EMAIL="you@example.com"
SEED_PASSWORD="change-me-too"
SEED_NAME="Me"
